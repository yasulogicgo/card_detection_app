#!/bin/sh
# Blocks Hugging Face tokens from being committed (GitHub push protection).
pattern='hf_[A-Za-z0-9]{20,}'

if git diff --cached -U0 | grep -E "$pattern" >/dev/null 2>&1; then
  echo ""
  echo "ERROR: Hugging Face token detected in staged changes."
  echo "Put your token only in env.json (gitignored), not in source code or comments."
  echo "See README.md -> One-time setup."
  echo ""
  exit 1
fi

exit 0
